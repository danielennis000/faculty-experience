{
  "name": "faculty-insight-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend-only React prototype for faculty Canvas activity insights and simulated interventions.",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "build:gh-pages": "VITE_BASE_PATH=/faculty-experience npm run build",
